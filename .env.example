# Required for hosted generation with Llama2 on Hugging Face
HUGGINGFACEHUB_API_TOKEN=

# Model to use for answer generation
LLM_MODEL_ID=meta-llama/Llama-2-7b-chat-hf

# Embedding model used for retrieval index
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# Data and index paths
DATA_DIR=./data
VECTOR_STORE_DIR=./vector_store
TOP_K=4
MAX_NEW_TOKENS=512
TEMPERATURE=0.2
